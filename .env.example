# NearGo Environment Configuration Template
# Copy this to .env and fill in values

# Supabase Database & Auth
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server Port
PORT=5001

# Sarvam AI (Optional - for local language translations & voice)
SARVAM_API_KEY=

# SMTP Email Server (Optional - for password resets)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="NearGo Support <support@neargo.in>"

# Cloudinary Image CDN (Free Tier)
CLOUDINARY_CLOUD_NAME=ube034gp
VITE_CLOUDINARY_CLOUD_NAME=ube034gp
VITE_CLOUDINARY_UPLOAD_PRESET=neargo_uploads

# Backend-only Cloudinary credentials (Optional - for server-side admin/deletion)
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
